# ═══════════════════════════════════════════════════════════════
#  NOBLEMAN MUSICAL CENTER — Environment Variables
#  Copy to .env.local and fill in values
# ═══════════════════════════════════════════════════════════════

# ─── DATABASE ─────────────────────────────────────────────────
DATABASE_URL=                        # Neon Postgres connection string (postgresql://...)

# ─── AUTH (Auth.js v5) ───────────────────────────────────────
AUTH_SECRET=                         # Generate: openssl rand -base64 32
# AUTH_URL is auto-detected by Auth.js from the deployment URL

# ─── GOOGLE OAUTH ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=                    # Google Cloud Console → Credentials → OAuth 2.0
GOOGLE_CLIENT_SECRET=                # Same location

# ─── PAYSTACK ─────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=                 # sk_live_... or sk_test_... (Paystack Dashboard → Settings → API Keys)
PAYSTACK_WEBHOOK_SECRET=             # Paystack Dashboard → Settings → Preferences → Webhooks → Signature

# ─── MTN MOMO ─────────────────────────────────────────────────
MOMO_API_USER=                       # MoMo Developer Portal → Collections → User ID
MOMO_API_KEY=                        # MoMo Developer Portal → Collections → API Key
MOMO_SUBSCRIPTION_KEY=               # MoMo Developer Portal → Products → Subscription Key
MOMO_TARGET_ENVIRONMENT=sandbox      # sandbox | production

# ─── WHATSAPP CLOUD API ───────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=            # Meta Business → WhatsApp → API Setup → Phone number ID
WHATSAPP_ACCESS_TOKEN=               # Meta Business → System User → Token
NEXT_PUBLIC_WHATSAPP_NUMBER=         # 233XXXXXXXXX (display number for wa.me links)

# ─── RESEND (Email) ──────────────────────────────────────────
RESEND_API_KEY=                      # Resend Dashboard → API Keys
EMAIL_FROM=noreply@noblemanmusical.com  # Verified sender in Resend

# ─── TYPESENSE (Search — optional, falls back to local DB) ───
TYPESENSE_NODES=http://localhost:8108  # Comma-separated for cluster
TYPESENSE_API_KEY=                     # Typesense API key

# ─── CRON JOBS ────────────────────────────────────────────────
CRON_SECRET=                         # Generate: openssl rand -hex 32 (auto-set by Vercel)

# ─── ADMIN ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@noblemanmusical.com  # Receives low stock alerts, quote notifications

# ─── SEED SCRIPT ──────────────────────────────────────────────
SEED_ADMIN_PASSWORD=Admin@123        # Password for admin@nobleman.com during db:seed

# ─── SITE ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000  # Production: https://noblemanmusical.com
