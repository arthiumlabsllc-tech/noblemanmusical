    "lucide-react": "^0.475.0",
    "next": "^15.3.3",
    "next-auth": "^5.0.0-beta.25",
    "postcss": "^8.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.54.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
